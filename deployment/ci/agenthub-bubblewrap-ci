# New mount permissions cover a subset of operations used by Bubblewrap v0.8.0.
# This profile applies to ALL processes in the opted-in CI container.
abi <abi/3.0>,
#include <tunables/global>
profile agenthub-bubblewrap-ci flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny network ax25,
  deny network ipx,
  deny network appletalk,
  deny network netrom,
  deny network rose,
  deny network econet,
  deny network atmsvc,
  deny network irda,
  deny network wanpipe,
  deny network isdn,
  deny network caif,
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=dockerd,
  signal (send,receive) peer=agenthub-bubblewrap-ci,
  ptrace (trace,tracedby,read,readby) peer=agenthub-bubblewrap-ci,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Exact propagation operations; no generic mount grant.
  mount options=(rw,rslave) -> /,
  mount options=(rw,rslave,silent) -> /,
  mount options=(rw,rprivate) -> /oldroot/,
  mount options=(rw,rprivate,silent) -> /oldroot/,
  # Only these fresh filesystem types in the temporary sandbox root.
  mount fstype=tmpfs -> /tmp/,
  mount fstype=tmpfs -> /newroot/**,
  mount fstype=proc -> /newroot/**,
  mount fstype=devpts -> /newroot/**,
  # v0.8.0 initial recursive self-bind targets the directory itself, not children.
  # aa_bind_mount masks flags to MS_BIND|MS_REC; directory paths end in slash.
  mount options=(rw,rbind) /tmp/newroot/ -> /tmp/newroot/,
  # --ro-bind / / binds the old root onto the new root itself after first pivot.
  mount options=(rw,rbind) /oldroot/ -> /newroot/,
  # Selected source binds, before/after first pivot.
  mount options=(rw,bind) -> /tmp/newroot/**,
  mount options=(rw,bind,silent) -> /tmp/newroot/**,
  mount options=(rw,rbind) -> /tmp/newroot/**,
  mount options=(rw,rbind,silent) -> /tmp/newroot/**,
  mount options=(rw,bind) -> /newroot/**,
  mount options=(rw,bind,silent) -> /newroot/**,
  mount options=(rw,rbind) -> /newroot/**,
  mount options=(rw,rbind,silent) -> /newroot/**,
  # Existing mounts only; no new filesystem type permission is implied.
  # bind_mount remounts the root destination itself before its descendants.
  remount /newroot/,
  remount /newroot/**,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root oldroot=/newroot/ /newroot/,
}
