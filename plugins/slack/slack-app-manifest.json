{
  "display_information": {"name": "AgentHub Reference", "description": "AgentHub authorized channel assistant", "background_color": "#24344d"},
  "features": {"bot_user": {"display_name": "AgentHub", "always_online": false}},
  "oauth_config": {"scopes": {"bot": ["chat:write", "channels:history", "groups:history", "channels:read", "groups:read", "users:read"]}},
