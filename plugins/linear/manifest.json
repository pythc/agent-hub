{
  "id": "agenthub-linear",
  "kind": "linear",
  "label": "Linear",
  "version": "1.0.0",
  "stateVersion": 1,
  "scopesPath": "/options/teams",
  "commandPath": "/options/command",
  "cursorMode": "scope",
  "cursorEncoding": "iso",
  "methods": [
    "start",
    "poll",
    "identity",
    "members",
    "read",
    "context",
    "deliver",
    "probe",
    "close"
  ],
  "stateKinds": [
    "source-cursor",
    "source-message-observation",
    "plugin-state"
  ],
  "credentials": {
    "TOKEN": "/options/tokenEnv"
  },
  "network": true,
  "tools": [
    {
      "name": "message_read",
      "resource": "message",
      "description": "Read the exact admitted Linear issue or comment; changed or unavailable anchors fail.",
      "inputSchema": {
        "type": "object",
        "required": [
          "triggerId"
        ],
        "properties": {
          "triggerId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "issue_read",
      "resource": "issue",
      "description": "Read the issue associated with a task-authorized Linear trigger, including its current workflow state and project reference.",
      "inputSchema": {
        "type": "object",
        "required": [
          "triggerId"
        ],
        "properties": {
          "triggerId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "thread_read",
      "resource": "thread",
      "description": "Read comments on the task-authorized Linear issue with bounded pagination.",
      "inputSchema": {
        "type": "object",
        "required": [
          "triggerId"
        ],
        "properties": {
          "triggerId": {
            "type": "string"
          },
          "cursor": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "configSchema": {
    "type": "object",
    "required": [
      "options"
    ],
    "properties": {
      "options": {
        "type": "object",
        "required": [
          "teams",
          "workspaceId",
          "tokenEnv",
          "command"
        ],
        "properties": {
          "teams": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{8}-(?:[a-fA-F0-9]{4}-){3}[a-fA-F0-9]{12}$"
            }
          },
          "workspaceId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{8}-(?:[a-fA-F0-9]{4}-){3}[a-fA-F0-9]{12}$"
          },
          "issueIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{8}-(?:[a-fA-F0-9]{4}-){3}[a-fA-F0-9]{12}$"
            }
          },
          "tokenEnv": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "authType": {
            "enum": [
              "api-key",
              "oauth"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "apiBase": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "setup": {
    "description": "Use an API key or OAuth access token with read and comments:create access. Select an expected workspace UUID and explicit team UUIDs; optional issueIds further restricts access. Set authType to api-key or oauth and store credentials only in the named host environment variable. Polling resumes a persisted issues/comments update window. Issue workflow states do not complete AgentHub goals. This transport does not host webhook endpoints, manage OAuth renewal, create issues or mutate statuses.",
    "fields": [
      {
        "name": "token-env",
        "label": "Credential environment variable",
        "secret": true,
        "required": true
      },
      {
        "name": "workspace-id",
        "label": "Expected workspace UUID",
        "required": true
      },
      {
        "name": "teams",
        "label": "Allowed team UUIDs",
        "required": true
      }
    ]
  }
}
