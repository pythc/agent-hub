{
  "name": "agent-hub",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Roppo: a local-first multi-agent workspace with a coordinating Router, independent Workers, and an embedded browser.",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "setup:terminal-font": "node bin/install-terminal-font.mjs",
    "start": "tsx src/cli.ts",
    "verify-recovery-package": "node --import tsx/esm src/recovery-package-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck:chat && npm run typecheck:ui",
    "check": "npm run typecheck && npm test && npm run test:tui",
    "test:tui": "bun tests/terminal-tui.ts && bun tests/terminal-attachments-tui.ts",
    "demo": "tsx examples/native-smoke.ts",
    "build:chat": "vite build --config web/chat/vite.config.ts",
    "dev:ui": "vite --config web/component-preview/vite.config.ts",
    "build:ui": "vite build --config web/component-preview/vite.config.ts",
    "typecheck:ui": "tsc -p web/component-preview/tsconfig.json",
    "typecheck:chat": "tsc -p web/chat/tsconfig.json",
    "prestart": "npm run build:chat",
    "pretest": "npm run build:chat"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/react-markdown": "0.14.24",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentui/core": "0.9.9",
    "@wecom/aibot-node-sdk": "1.0.7",
    "adm-zip": "0.6.1",
    "agent-browser": "0.27.0",
    "ajv": "8.20.0",
    "bun": "1.4.5",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "katex": "0.19.1",
    "lucide-react": "1.70.0",
    "playwright-core": "1.65.1",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "smol-toml": "1.9.1",
    "string-width": "7.2.0",
    "tsx": "4.23.15",
    "unified": "11.0.5",
    "uqr": "0.1.2",
    "wrap-ansi": "9.0.2",
    "ws": "8.22.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "postcss": "8.5.32",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  },
  "license": "Apache-2.0",
  "overrides": {
    "katex": "$katex"
  },
  "optionalDependencies": {
    "opencode-ai": "1.19.5"
  },
  "bin": {
    "roppo": "bin/roppo.mjs"
  },
  "allowScripts": {
    "bun@1.4.5": true
  }
}
