{
  "name": "agent-hub",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Roppo: a local-first multi-agent workspace with a coordinating Router, independent Workers, and an embedded browser.",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck:chat",
    "check": "npm run typecheck && npm test",
    "demo": "tsx examples/native-smoke.ts",
    "build:chat": "vite build --config web/chat/vite.config.ts",
    "typecheck:chat": "tsc -p web/chat/tsconfig.json",
    "prestart": "npm run build:chat",
    "pretest": "npm run build:chat"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/react-markdown": "0.14.24",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@wecom/aibot-node-sdk": "1.0.7",
    "agent-browser": "0.27.0",
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "postcss": "8.5.32",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "esbuild": "0.28.2"
  },
  "license": "Apache-2.0"
}
